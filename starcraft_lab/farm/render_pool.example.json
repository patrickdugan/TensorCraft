{
  "schema": 1,
  "max_parallel": 1,
  "capacity": {
    "cpu_budget_threads": 4,
    "threads_per_render": 3,
    "ram_budget_mb": 8192,
    "ram_per_render_mb": 4096
  },
  "capture_limit_seconds": 3600,
  "ready_timeout_seconds": 120,
  "replay_launcher": [
    "python3",
    "-m",
    "starcraft_lab.farm.replay_gui",
    "--run-id",
    "{run_id}",
    "--replay",
    "{replay}",
    "--mod",
    "{mod_mpq}",
    "--ready",
    "{ready_marker}",
    "--done",
    "{done_marker}",
    "--display",
    "{display}",
    "--game-dir",
    "{game_dir}",
    "--mpqdraft",
    "/private/BWLab/tools/MPQDraft-modernized.exe",
    "--qdp",
    "/private/BWLab/tools/BWAPI_PluginInjector.qdp",
    "--observer",
    "/private/BWLab/tools/TensorCraftTrace.dll"
  ],
  "slots": [
    {
      "id": "video01",
      "game_dir": "/private/BWLab/render-workers/video01/StarCraft",
      "wineprefix": "/private/BWLab/render-workers/video01/wineprefix",
      "display": ":121"
    }
  ],
  "notes": "Uses modernized sjoblomj/MPQDraft CLI, BWAPI 4.4 auto_menu replay, and privately linked x86 TensorCraftTrace.dll. Native playback and MPQ effects require a smoke test. PYTHONPATH must include the TensorCraft repo in the GUI wrapper subprocess."
}
