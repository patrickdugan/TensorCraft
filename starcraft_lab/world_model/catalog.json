  "semantics": {
    "speed": "Pixels per Brood War logical frame; upgrades, accel, turn and collision omitted unless explicitly modeled",
    "cooldown": "Nominal weapon cooldown frames; live attack scheduling also depends on attack animation, orders and latency",
    "costs": "Total purchase/replacement costs including source Mutalisk for Devourer/Guardian; sunk infrastructure excluded",
    "bounce": "Mutalisk primary 9, secondary 3, tertiary 1 before armor and acid-spore bonus",
    "hits_per_attack": "Composite attack approximation; actual shots, projectiles and armor applications must be verified",
    "splash_radius_px": "Research-model prior, not an extracted DAT constant; must calibrate",
    "initial_armor": "Nominal armor before upgrades",
    "validity": "Official unit tables for HP, cost, damage and cooldown; community extracted movement speeds, approximated special attack implementation"
  },
